{
  // Cloudflare Workers with static assets. Deploy with `npm run deploy`.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "qorvyn-systems",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./out",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
  // To serve the custom domain from this Worker, add:
  // "routes": [{ "pattern": "qorvynsystems.com", "custom_domain": true }]
}
